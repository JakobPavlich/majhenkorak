<h1>Nove objave ta tedn</h1>

<ul>
  <% params[:posts].each do |post| %>
    <li><%= link_to post do %>
        <%= post.title %>
        -
        <%= post.label %>
      <% end %>
      <div>
        <%= post.favnumber %>
        -
        <%= post.region %>
      </div>
    </li>
  <% end %>
</ul>

<%= link_to "Odjavi se",
unsubscribe_url(token: params[:subscriber].generate_token_for(:unsubscribe)) %>
