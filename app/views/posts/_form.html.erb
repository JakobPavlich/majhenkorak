<div class="post-form">
  <%= form_with model: post, data: {turbo: false} do |form| %>
    <%= render "errors", form: form %>

    <div class="form-group">
      <%= form.label :title %>
      <%= form.text_field :title, placeholder: "dont know", required: true %>
    </div>

    <div class="form-group">
      <%= form.label :label %>
      <%= form.text_field :label, placeholder: "also dont know", required: true %>
    </div>

    <div class="form-group">
      <%= form.label :favnumber %>
      <%= form.number_field :favnumber, placeholder: "7", required: true %>
    </div>

    <div class="form-group">
      <%= form.label :region %>
      <%= form.text_field :region, placeholder: "still dont know", required: true %>
    </div>

    <div class="form-group">
      <%= form.label :apply_url %>
      <%= form.url_field :apply_url, placeholder: "url" %>
    </div>

    <div class="form-group">
      <%= form.label :apply_email %>
      <%= form.email_field :apply_email, placeholder: "email" %>
    </div>
    <div class="form-group">
      <div>
        <%= form.label :description %>
        <%= form.rich_textarea :description, required: true %>
      </div>
    </div>
    <div class="cf-turnstile" data-sitekey="<%= ENV.fetch("TURNSTILE_SITE_KEY") %>"></div>

    <div><%= form.submit "Shrani", class: "post-button" %></div>
  <% end %>
</div>
