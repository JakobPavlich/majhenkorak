<div class="posts">
  <h3>Post a post</h3>

  <div class="post-form">
    <%= form_with model: @post do |form| %>
      <%= render "errors", form: form %>

      <div>
        <%= form.label :title %> <%= form.text_field :title, placeholder: "dont
      know", required: true %>
      </div>

      <div>
        <%= form.label :label %> <%= form.text_field :label, placeholder: "also
      dont know", required: true %>
      </div>

      <div>
        <%= form.label :favnumber %> <%= form.number_field :favnumber,
      placeholder: "7", required: true %>
      </div>

      <div>
        <%= form.label :region %> <%= form.text_field :region, placeholder: "still
      dont know", required: true %>
      </div>

      <div>
        <%= form.label :apply_url %> <%= form.url_field :apply_url, placeholder:
      "url" %>
      </div>

      <div>
        <%= form.label :apply_email %> <%= form.email_field :apply_email,
      placeholder: "email" %>
      </div>

      <div><%= form.submit %></div>
    <% end %>
  </div>
</div>
